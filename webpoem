#!/usr/bin/env python3
"""CLI for managing the webpoem server."""

import argparse
import os
import signal
import subprocess
import sys


PID_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".webpoem", "pid")
APP = os.path.join(os.path.dirname(os.path.abspath(__file__)), "app.py")


def ensure_pid_dir():
    """Create the .webpoem directory if it doesn't exist."""
    os.makedirs(os.path.dirname(PID_FILE), exist_ok=True)


def get_pid():
    """Read the PID from the file. Returns None if not found."""
    try:
        with open(PID_FILE, "r") as f:
            return int(f.read().strip())
    except (FileNotFoundError, ValueError):
        return None


def is_running(pid):
    """Check if a process with the given PID is running."""
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def start():
    """Start the webpoem server."""
    pid = get_pid()
    if pid and is_running(pid):
        print(f"Server is already running (PID {pid})")
        return

    # Kill stale PID file if it exists
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass

    ensure_pid_dir()

    # Start the server
    proc = subprocess.Popen(
        [sys.executable, APP],
        cwd=os.path.dirname(APP),
        start_new_session=True,
    )

    # Wait a moment and verify it started
    import time
    time.sleep(0.5)

    if proc.poll() is not None:
        print("Failed to start server")
        sys.exit(1)

    with open(PID_FILE, "w") as f:
        f.write(str(proc.pid))

    print(f"Server started (PID {proc.pid})")


def stop():
    """Stop the webpoem server."""
    pid = get_pid()
    if not pid:
        print("Server is not running")
        return

    if not is_running(pid):
        print("Server process not found, cleaning up PID file")
        os.remove(PID_FILE)
        return

    try:
        os.kill(pid, signal.SIGTERM)
        print(f"Server stopped (PID {pid})")
    except ProcessLookupError:
        print("Server process not found, cleaning up PID file")

    if os.path.exists(PID_FILE):
        os.remove(PID_FILE)


def status():
    """Show the server status."""
    pid = get_pid()
    if not pid:
        print("Server is not running")
        return

    if is_running(pid):
        print(f"Server is running (PID {pid})")
    else:
        print("Server process not found (stale PID file)")


def restart():
    """Restart the webpoem server."""
    stop()
    start()


def main():
    parser = argparse.ArgumentParser(description="Manage the webpoem server")
    parser.add_argument(
        "command",
        choices=["start", "stop", "restart", "status"],
        help="Command to run",
    )
    args = parser.parse_args()

    commands = {
        "start": start,
        "stop": stop,
        "restart": restart,
        "status": status,
    }

    commands[args.command]()


if __name__ == "__main__":
    main()
